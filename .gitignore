# Publish only the distributable skill and documentation.
# Local transcripts, generated reports, credentials and editor files stay untracked.
/*
!/.gitignore
!/SKILL.md
!/README.md
!/assets/
/assets/*
!/assets/report.html
!/scripts/
/scripts/*
!/scripts/render_report.py
!/references/
/references/*
!/references/report-design.md
!/references/live-interview.md
